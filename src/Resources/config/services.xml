<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
  <services>
    <defaults autowire="true" autoconfigure="true" public="false"/>

    <service id="Skyyware\SkyyAddressValidation\Config\AddressValidationConfig">
      <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
    </service>

    <service id="Skyyware\SkyyAddressValidation\Provider\NominatimCompatibleProvider">
      <argument type="service" id="http_client"/>
      <argument type="service" id="Skyyware\SkyyAddressValidation\Config\AddressValidationConfig"/>
      <argument type="service" id="logger"/>
    </service>

    <service id="Skyyware\SkyyAddressValidation\Provider\ProviderRequestGate">
      <argument type="service" id="lock.factory"/>
      <argument type="service" id="cache.object"/>
    </service>

    <service id="Skyyware\SkyyAddressValidation\Provider\GatedAddressProvider">
      <argument type="service" id="Skyyware\SkyyAddressValidation\Provider\NominatimCompatibleProvider"/>
      <argument type="service" id="Skyyware\SkyyAddressValidation\Provider\ProviderRequestGate"/>
    </service>

    <service id="Skyyware\SkyyAddressValidation\Provider\CachedAddressProvider">
      <argument type="service" id="Skyyware\SkyyAddressValidation\Provider\GatedAddressProvider"/>
      <argument type="service" id="cache.object"/>
    </service>

    <service id="Skyyware\SkyyAddressValidation\Provider\AddressProviderInterface"
             alias="Skyyware\SkyyAddressValidation\Provider\CachedAddressProvider"/>

    <service id="Skyyware\SkyyAddressValidation\Service\RemoteAddressValidationService">
      <argument type="service" id="Skyyware\SkyyAddressValidation\Provider\AddressProviderInterface"/>
      <argument type="service" id="Skyyware\SkyyAddressValidation\Config\AddressValidationConfig"/>
      <argument type="service" id="country.repository"/>
      <argument type="service" id="logger"/>
    </service>

    <service id="Skyyware\SkyyAddressValidation\Subscriber\AddressValidationSubscriber">
      <argument type="service" id="Skyyware\SkyyAddressValidation\Config\AddressValidationConfig"/>
      <argument type="service" id="Skyyware\SkyyAddressValidation\Service\RemoteAddressValidationService"/>
      <tag name="kernel.event_subscriber"/>
    </service>
  </services>
</container>
